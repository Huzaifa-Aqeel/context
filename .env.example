# Optional in development: relative API requests use the Expo dev server.
# Native development uses the Expo server host automatically. Set this to the deployed HTTPS API origin before a native release build.
EXPO_PUBLIC_API_URL=

# Server-only credentials. Never use EXPO_PUBLIC_ for provider settings.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
TAVILY_API_KEY=
# Event research only. Optional origin; blank uses https://api.tavily.com.
TAVILY_API_URL=
GEOAPIFY_API_KEY=
# Optional server-only key for exact venue/restaurant addresses, hours, and phone details.
# Cultural ranking works without it. Context does not open maps or links.

# Shared OpenAI-compatible Chat Completions provider for reasoning, interest extraction,
# and vision. Set all three to switch providers; use any model with the required capabilities.
# URL is the HTTPS API root (e.g. https://your-provider.example/v1), not /chat/completions.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# Cultural-display brief and Ask may use a separate stronger model and endpoint.
# Blank credentials inherit LLM_* when the endpoint is the same.
# Existing SHELF_* variables remain accepted when their DISPLAY_* counterpart is blank.
DISPLAY_MODEL=qwen3.8-max
DISPLAY_API_KEY=
DISPLAY_API_URL=
DISPLAY_TIMEOUT_MS=90000
# Qwen3.8 Max on Alibaba reasons during the brief call by default, not Vision.
# Set true or false to override when switching models; blank uses the model default.
DISPLAY_BRIEF_THINKING=
# Optional separate image provider/model. Blank settings inherit LLM_*.
# Changing VISION_API_URL to a different endpoint requires VISION_API_KEY.
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=
VISION_TIMEOUT_MS=60000

# Optional dialect overrides (blank uses automatic defaults):
# LLM_TOKEN_PARAMETER=max_tokens  # or max_completion_tokens
# LLM_JSON_MODE=true             # false omits response_format, still validates JSON
# LLM_REQUEST_OPTIONS={"enable_thinking":false}
# LLM_PROVIDER_NAME=Your provider
# VISION_TOKEN_PARAMETER=max_tokens
# VISION_JSON_MODE=true
# VISION_REQUEST_OPTIONS={"enable_thinking":false}
# VISION_PROVIDER_NAME=Your image provider
# Alibaba defaults to non-thinking; Groq uses max_completion_tokens, others max_tokens.
# Request options cannot override model, messages, tools, tool_choice, response_format,
# stream, or output token limits. They can set provider-specific options/temperature.

# Independent OpenAI-compatible audio providers. Blank settings retain Groq defaults.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_MODEL=
TTS_API_KEY=
TTS_API_URL=
TTS_MODEL=
# Optional TRANSCRIPTION_PROVIDER_NAME, TTS_PROVIDER_NAME, TTS_VOICE.
# Speech requires WAV output and support for the selected app voices/direction tags.

# Legacy Groq settings: speech defaults and analysis fallback when LLM_* is empty.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
# Existing GROQ_TXT_SPEECH is also supported for the speech model.

# Set a stable HMAC secret in each deployment so locally saved Qloo profiles remain valid
# across app restarts and changes to model or provider API keys. Keep it private.
SESSION_SIGNING_KEY=
