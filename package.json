{
  "name": "context",
  "version": "1.0.0",
  "description": "An accessible Expo mobile companion for exploring visual cultural references and location-aware context with Qloo.",
  "license": "MIT",
  "keywords": [
    "accessibility",
    "blind",
    "low-vision",
    "cultural-context",
    "qloo",
    "expo",
    "react-native",
    "location",
    "hackathon"
  ],
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "expo lint",
    "export:server": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true
}
